# Copy to .env (PowerShell: Copy-Item .env.example .env) and fill in.
# .env is git-ignored. Never commit real keys.

# Anthropic API key. Not needed when MOCK_AI=1.
ANTHROPIC_API_KEY=

# Model for building lessons, and a faster model for short tasks.
LESSON_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-4-5

# 1 = serve golden fixtures, no API calls (use for all UI work and tests).
MOCK_AI=0

# edge-tts voice for narration.
TTS_VOICE=en-US-AriaNeural
