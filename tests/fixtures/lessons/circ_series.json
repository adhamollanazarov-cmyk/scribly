        "ru": "Последний вопрос. На каком резисторе падает наибольшая часть напряжения батареи и почему?"
      },
      "draw": [],
      "checkpoint": {
        "question": "In a series circuit, which resistor has the largest voltage across it?",
        "type": "choice",
        "choices": [
          "R1, because it is first in the circuit",
          "R2, because it is in the middle",
          "R3, because it has the largest resistance and the same current",
