    {
      "id": "s5",
      "kind": "explain",
      "say": "Ohm's law gives the current: I equals V over R equivalent. That is 0.0150 amperes.",
      "subtitles": {
        "uz": "Om qonuni tokni beradi: I = V / R ekv. Bu 0.0150 A ga teng.",
        "ru": "Закон Ома даёт ток: I равно V делить на R эквивалентное. Это 0.0150 A."
      },
      "draw": [
        {
          "id": "sym-omega",
          "color": "ink",
          "at": 0.0,
          "type": "symbol",
          "x": 740.0,
          "y": 410,
