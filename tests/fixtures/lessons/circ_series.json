    {
      "id": "s4",
      "kind": "checkpoint",
      "say": "Quick check. Suppose only R1 and R2 were connected in series. What would their equivalent resistance be?",
      "subtitles": {
        "uz": "Tez tekshiruv. Faqat R1 va R2 ketma-ket ulangan bo'lsa, ekvivalent qarshilik qancha bo'ladi?",
        "ru": "Быстрая проверка. Если бы последовательно были соединены только R1 и R2, чему равнялось бы эквивалентное сопротивление?"
      },
      "draw": [],
      "checkpoint": {
        "question": "If only R1 = 100 ohm and R2 = 200 ohm were in series, what is their equivalent resistance in ohms?",
        "type": "number",
        "answer": 300.0,
        "tolerance": 0.02,
        "unit": "Ω",
        "hint": "In series, just add the resistances.",
        "reexplain_hint": "Think of two narrow pipes one after another: the total difficulty for water is the sum of each pipe's difficulty."
      }
