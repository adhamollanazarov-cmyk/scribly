  "$defs": {
    "ArrowPrim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "enum": [
                "ink",
                "accent",
                "charge_pos",
                "charge_neg",
                "field",
                "surface",
                "force",
                "highlight",
                "wrong",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "at": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set by the server on template children. AI must not set it.",
          "title": "Group"
        },
        "type": {
          "const": "arrow",
          "title": "Type",
          "type": "string"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        },
        "x2": {
          "title": "X2",
          "type": "number"
        },
        "y2": {
          "title": "Y2",
          "type": "number"
        },
        "dashed": {
          "default": false,
          "title": "Dashed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "ArrowPrim",
      "type": "object"
    },
