  {
    "event": "step",
    "data": {
      "id": "s5",
      "kind": "checkpoint",
      "say": "Here is a bigger bubble around the same charge. Your turn: what happens to the flux through it?",
      "subtitles": {
        "uz": "Mana shu zaryad atrofida kattaroq pufak. Navbat sizda: undan o'tadigan oqim qanday o'zgaradi?",
        "ru": null
      },
      "draw": [
        {
          "id": "surface2-sphere",
          "color": "surface",
          "at": 0.1,
          "label": "bigger surface",
