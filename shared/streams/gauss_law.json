  {
    "event": "step",
    "data": {
      "id": "s3",
      "kind": "explain",
      "say": "Now imagine a closed bubble around the charge. It is not real, just a tool. We call it a Gaussian surface.",
      "subtitles": {
        "uz": "Endi zaryad atrofida yopiq pufakni tasavvur qiling. U haqiqiy emas, faqat vosita. Uni Gauss sirti deymiz.",
        "ru": null
      },
      "draw": [
        {
          "id": "surface1-sphere",
          "color": "surface",
          "at": 0.1,
          "label": "Gaussian surface",
          "group": "surface1",
          "type": "circle",
          "cx": 450.0,
          "cy": 500.0,
          "r": 130.0,
          "dashed": true
        }
      ],
