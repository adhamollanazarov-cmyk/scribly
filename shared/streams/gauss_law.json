  {
    "event": "step",
    "data": {
      "id": "s4",
      "kind": "explain",
      "say": "Electric flux measures how much field pokes through a surface. We write it as phi. Here, twelve lines cross the bubble, so the flux is twelve lines' worth.",
      "subtitles": {
        "uz": "Elektr oqimi sirtdan qancha maydon o'tishini ko'rsatadi. Uni fi (Φ) bilan belgilaymiz. Bu yerda pufakdan o'n ikkita chiziq o'tadi, demak oqim o'n ikki chiziqqa teng.",
        "ru": null
      },
      "draw": [
        {
          "id": "sym-phi",
          "color": null,
          "at": 0.2,
          "label": null,
          "group": null,
          "type": "symbol",
          "x": 60.0,
          "y": 130.0,
          "symbol": "\\Phi",
          "meaning": "electric flux",
          "unit": "N·m²/C"
        },
        {
          "id": "phi-label",
          "color": null,
          "at": 0.3,
          "label": null,
          "group": null,
          "type": "text",
          "x": 790.0,
          "y": 250.0,
          "text": "flux = Φ",
          "size": null
        },
