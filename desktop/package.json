{
  "name": "scribbly-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Scribbly overlay: an AI teacher that draws on top of any app",
  "author": "Scribbly",
  "main": "dist/main.js",
  "scripts": {
    "build:web": "npm --prefix ../web run build",
    "build": "node esbuild.mjs",
    "start": "npm run build:web && npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "npm run build:web && npm run build && playwright test",
    "dist": "npm run build:web && npm run build && electron-builder --win --x64"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
