        {
          "question": "If the object moves closer to the lens but stays outside the focal point, where does the real image go?",
          "type": "choice",
          "choices": [
            "Closer to the lens, and it shrinks",
            "To the object’s side of the lens",
            "Farther from the lens, and it grows",
            "Nowhere; it stays fixed"
          ],
          "answer": "2",
          "hint": "In the thin-lens equation, a smaller object distance needs a larger image distance.",
          "reexplain_hint": "Picture rays from an object near the focal point: they leave almost parallel and meet far away."
        }
